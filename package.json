{
  "name": "impact-ledger",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Typed, dependency-free browser interface for a synthetic nonprofit operations ledger",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && python3 scripts/build_site.py",
    "test": "node --test tests/frontend.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
}
